# Node environment: development | production | test
NODE_ENV=development

# HTTP port the API listens on
PORT=3000

# Postgres connection - through PgBouncer (HW #15): pgbouncer:6432 -> postgres:5432.
# The direct Postgres port (5432) is kept only for admin tasks (pg_dump, drill).
DB_HOST=localhost
DB_PORT=6432
DB_NAME=marketplace
DB_USER=marketplace_app

# Path to the file holding the DB password secret (never the password itself).
# The real file lives outside git — see secrets/db_password and README > Configuration.
DB_PASSWORD_FILE=secrets/db_password

# Single connection string for psql / tooling / the grader (HW #3). Password
# here is the docker-compose dev default, not a real secret — see README > Configuration.
DATABASE_URL=postgresql://marketplace_app:changeme_local_dev_password@localhost:6432/marketplace
