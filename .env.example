# Node environment: development | production | test
NODE_ENV=development

# HTTP port the API listens on
PORT=3000

# Postgres connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=marketplace
DB_USER=marketplace_app

# Path to the file holding the DB password secret (never the password itself).
# The real file lives outside git — see secrets/db_password and README > Configuration.
DB_PASSWORD_FILE=secrets/db_password

# Single connection string for psql / tooling / the grader (ДЗ #3). Password
# here is the docker-compose dev default, not a real secret — see README > Configuration.
DATABASE_URL=postgresql://marketplace_app:changeme_local_dev_password@localhost:5432/marketplace
